{
  "name": "usdt-cpa",
  "productName": "USDT CPA",
  "version": "1.2.2",
  "description": "Control de compra y venta de USDT (Binance P2P) con tasa BCV - CPA Bejuma / Panamericana",
  "main": "electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "CPA Bejuma C.A.",
  "scripts": {
    "construir:web": "esbuild src/main.js --bundle --format=iife --target=chrome110 --outfile=www/js/app.js --log-level=warning",
    "escritorio": "npm run construir:web && electron .",
    "compilar:exe": "npm run construir:web && electron-builder --win --x64 --publish never",
    "android:sincronizar": "npm run construir:web && cap sync android",
    "android:iconos": "capacitor-assets generate --android --iconBackgroundColor #0b0e11 --iconBackgroundColorDark #0b0e11 --splashBackgroundColor #0b0e11 --splashBackgroundColorDark #0b0e11",
    "compilar:apk": "npm run android:sincronizar && cd android && gradlew.bat assembleRelease"
  },
  "build": {
    "appId": "ve.cpabejuma.usdt",
    "productName": "USDT CPA",
    "artifactName": "USDT-CPA-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist/windows",
      "buildResources": "recursos"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "recursos/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "recursos/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "USDT CPA",
      "language": "3082"
    },
    "portable": {
      "artifactName": "USDT-CPA-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AlexMielno",
        "repo": "usdt-cpa",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@electron/packager": "^20.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4"
  }
}
